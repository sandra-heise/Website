---
import Layout from '../layouts/Layout.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const links = [
  { href: `${base}/malen`,     label: "Malbücher & Leinwände" },
  { href: `${base}/gemaelde`,  label: "Original-Gemälde" },
  { href: `${base}/portfolio#portraets`, label: "Porträt-Aufträge" },
  { href: `${base}/basteln`,   label: "Basteln" },
  { href: `${base}/downloads`, label: "Kostenlose Downloads" },
  { href: `${base}/blog`,      label: "Blog" },
  { href: `${base}/kontakt`,   label: "Kontakt" },
];
---

<Layout
  title="Seite nicht gefunden – Sunny Artis"
  description="Diese Seite existiert leider nicht. Entdecke stattdessen Malbücher, Gemälde, Porträts und kreative Ideen bei Sunny Artis."
>
  <section class="not-found">
    <div class="container">
      <div class="art-number" aria-hidden="true">404</div>

      <h1>Diese Seite haben wir leider nicht gefunden</h1>
      <p class="lead">
        Vielleicht wurde der Link verschoben oder umbenannt – das passiert manchmal beim Umzug eines Shops.<br />
        Hier findest du alles, was Sunny Artis zu bieten hat:
      </p>

      <nav class="quick-links" aria-label="Wichtige Seiten">
        {links.map(l => (
          <a href={l.href} class="quick-link">{l.label}</a>
        ))}
      </nav>

      <a href={`${base}/`} class="btn-home">Zur Startseite</a>
    </div>
  </section>
</Layout>

<style>
  .not-found {
    min-height: 70vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 4rem 1.5rem;
    background: linear-gradient(160deg, var(--color-bg-light) 0%, var(--color-bg-white) 100%);
    text-align: center;
  }

  .container {
    max-width: 680px;
    width: 100%;
  }

  .art-number {
    font-family: var(--font-logo);
    font-size: clamp(6rem, 20vw, 12rem);
    font-weight: 700;
    line-height: 1;
    background: linear-gradient(135deg, var(--color-tuerkis) 0%, var(--color-teal) 60%, var(--color-soft-blue) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    letter-spacing: -0.04em;
    margin-bottom: 1rem;
    user-select: none;
  }

  h1 {
    font-size: clamp(1.4rem, 3.5vw, 2rem);
    color: var(--color-navy);
    margin-bottom: 1rem;
  }

  .lead {
    color: var(--color-text-muted);
    font-size: 1.05rem;
    line-height: 1.7;
    margin-bottom: 2.5rem;
  }

  .quick-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    justify-content: center;
    margin-bottom: 2.5rem;
  }

  .quick-link {
    display: inline-block;
    padding: 0.5rem 1.1rem;
    border: 1.5px solid var(--color-soft-blue);
    border-radius: 999px;
    color: var(--color-tuerkis);
    font-family: var(--font-title);
    font-size: 0.9rem;
    font-weight: 500;
    text-decoration: none;
    transition: background var(--transition-fast), border-color var(--transition-fast), color var(--transition-fast);
  }

  .quick-link:hover {
    background: var(--color-tuerkis);
    border-color: var(--color-tuerkis);
    color: #fff;
  }

  .btn-home {
    display: inline-block;
    padding: 0.85rem 2rem;
    background: var(--color-navy);
    color: #fff;
    font-family: var(--font-title);
    font-weight: 600;
    font-size: 1rem;
    border-radius: 8px;
    text-decoration: none;
    transition: background var(--transition-fast), transform var(--transition-fast);
  }

  .btn-home:hover {
    background: var(--color-tuerkis);
    transform: translateY(-2px);
  }
</style>
