---
import Layout from '../../layouts/Layout.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const SITE = "https://www.sunnyartis.de";
const canonicalUrl = `${SITE}/blog/herbstabende-malbuch`;
const ogImage = `${SITE}/blog/herbstabende-hero.jpg`;

const routine = [
  {
    name: "Kerze anzünden",
    text: "Eine warme Lichtquelle statt greller Deckenbeleuchtung — das allein senkt schon den Puls. Ein Windlicht oder eine Duftkerze mit Zimt oder Vanille passt perfekt zur Jahreszeit."
  },
  {
    name: "Tee aufgießen",
    text: "Ob Kräuter-, Gewürz- oder Schwarztee — die Tasse in der Hand ist Teil des Rituals. Nimm dir bewusst Zeit zum Ziehenlassen, statt direkt loszulegen."
  },
  {
    name: "Handy weglegen",
    text: "Ausmalen wirkt vor allem dann entspannend, wenn nichts anderes um Aufmerksamkeit konkurriert. Flugmodus an, Benachrichtigungen aus — 20 Minuten reichen völlig."
  },
  {
    name: "Malbuch aufschlagen",
    text: "Wähle ein Motiv ganz nach Tagesform: ein kleines für zwischendurch, ein detailreiches für einen langen Abend. Es gibt kein Falsch — nur Farben, die du gerade magst."
  }
];

const buecher = [
  {
    title: "Eine Welt voller Katzen",
    beschreibung: "Witzige Katzenmotive im Comic-Stil — leicht und verspielt, ideal für einen entspannten Feierabend.",
    image: `${base}/malbuecher/Malbuch-Katzen.jpg`,
    preis: "ab 7,99€",
  },
  {
    title: "Malbuch Magie",
    beschreibung: "Mandalas, geometrische Symbole und 25 inspirierende Zitate — meditativ und perfekt für lange, ruhige Abende.",
    image: `${base}/malbuecher/malbuch-magie.jpg`,
    preis: "ab 9,99€",
  },
  {
    title: "Fantasie in Farbe",
    beschreibung: "25 abstrakte, geometrische Motive zum Verlieren — für alle, die beim Ausmalen komplett abschalten wollen.",
    image: `${base}/malbuecher/fantasie-in-farbe-teenager.jpg`,
    preis: "ab 9,99€",
  },
];
---

<Layout
  title="Gemütliche Herbstabende: Malbuch, Kerze & Tee | Sunny Artis"
  description="Ausmalen als Herbstritual: Wie du dir mit Malbuch, Kerze und Tee einen entspannten Feierabend gestaltest — inkl. Buchempfehlungen für lange Abende."
  ogImage={ogImage}
  canonical={canonicalUrl}
>
  <meta name="keywords" content="Herbst Malbuch, Ausmalen entspannen, gemütlicher Abend, Malbuch für Erwachsene, Sandra Heise Blog" slot="head" />
  <meta property="article:published_time" content="2026-09-08" slot="head" />
  <meta property="article:author" content="Sandra Heise" slot="head" />
  <meta property="article:section" content="Lifestyle & Entspannung" slot="head" />
  <meta property="article:tag" content="Herbst" slot="head" />
  <meta property="article:tag" content="Malbuch" slot="head" />
  <meta property="og:type" content="article" slot="head" />
  <script is:inline type="application/ld+json" slot="head" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    "headline": "Gemütliche Herbstabende: Malbuch, Kerze & Tee",
    "description": "Ausmalen als Herbstritual: Wie du dir mit Malbuch, Kerze und Tee einen entspannten Feierabend gestaltest.",
    "image": ogImage,
    "datePublished": "2026-09-08",
    "dateModified": "2026-09-08",
    "keywords": "Herbst Malbuch, Ausmalen entspannen, gemütlicher Abend, Malbuch für Erwachsene",
    "inLanguage": "de",
    "url": canonicalUrl,
    "mainEntityOfPage": { "@type": "WebPage", "@id": canonicalUrl },
    "author": { "@type": "Person", "name": "Sandra Heise", "url": SITE, "sameAs": ["https://www.instagram.com/sunny_artis/", "https://www.youtube.com/@SunnyArtis"] },
    "publisher": { "@type": "Person", "name": "Sandra Heise", "url": SITE },
    "speakable": { "@type": "SpeakableSpecification", "cssSelector": [".article-title", ".article-container h2", ".step-text"] },
    "isPartOf": { "@type": "Blog", "name": "Sunny Artis Blog", "url": `${SITE}/blog` }
  })} />
  <script is:inline type="application/ld+json" slot="head" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "Warum ist Ausmalen im Herbst besonders entspannend?",
        "acceptedAnswer": { "@type": "Answer", "text": "Kürzere Tage laden mehr zum Drinnenbleiben ein. Ausmalen lenkt den Fokus auf eine einzige, ruhige Tätigkeit ohne Bildschirm und wirkt dadurch ähnlich entspannend wie Meditation — ideal für gemütliche Abende bei Kerzenschein." }
      },
      {
        "@type": "Question",
        "name": "Welches Malbuch eignet sich für lange Herbstabende?",
        "acceptedAnswer": { "@type": "Answer", "text": "Für ruhige, meditative Abende eignen sich detailreiche Motive wie im Malbuch Magie oder Fantasie in Farbe besonders gut. Wer es verspielter mag, greift zu Eine Welt voller Katzen mit seinen leichten Comic-Motiven." }
      }
    ]
  })} />
  <script is:inline type="application/ld+json" slot="head" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Startseite", "item": SITE },
      { "@type": "ListItem", "position": 2, "name": "Blog", "item": `${SITE}/blog` },
      { "@type": "ListItem", "position": 3, "name": "Gemütliche Herbstabende", "item": canonicalUrl }
    ]
  })} />

  <section class="article-hero">
    <div class="container">
      <div class="article-meta">
        <a href={`${base}/blog`} class="back-link">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="19" y1="12" x2="5" y2="12"></line><polyline points="12 19 5 12 12 5"></polyline></svg>
          Zurück zum Blog
        </a>
        <span class="article-category">Lifestyle & Entspannung</span>
      </div>
      <h1 class="article-title">Gemütliche Herbstabende: Malbuch, Kerze & Tee</h1>
      <p class="article-date">8. September 2026 · von Sandra Heise</p>
    </div>
  </section>

  <article class="article-body">
    <div class="container article-container">

      <figure class="article-figure article-figure--top">
        <img src={`${base}/blog/herbstabende-hero.jpg`} alt="Aufgeschlagenes Katzen-Malbuch mit bunten Filzstiften an einem gemütlichen Abend" fetchpriority="high" loading="eager" />
      </figure>

      <p>
        Die Tage werden kürzer, es wird früher dunkel, und drinnen wird es wieder gemütlich. Für mich ist der Herbst die schönste Zeit für ein ganz bestimmtes Ritual: eine Kerze anzünden, eine Tasse Tee aufgießen — und ein Malbuch aufschlagen. Kein Ziel, kein Zeitdruck, einfach nur Farbe für Farbe entspannen.
      </p>

      <h2>Warum Ausmalen im Herbst so guttut</h2>
      <p>
        Ausmalen ist eine der einfachsten Formen von Achtsamkeit, die ich kenne. Man muss nichts können, nichts lernen — man muss nur anfangen. Der Fokus auf Linien und Farben lässt den Kopf zur Ruhe kommen, ganz ohne Bildschirm und ohne To-do-Liste im Hinterkopf. Gerade an dunklen Herbstabenden, wenn man ohnehin lieber drinnen bleibt, ist das die perfekte Beschäftigung für Hände und Gedanken gleichzeitig.
      </p>
      <p>
        Anders als beim Fernsehen bleibt man dabei aktiv und kreativ — und hat am Ende sogar ein kleines Kunstwerk in der Hand, auf das man stolz sein kann.
      </p>

      <h2>Deine Herbst-Ausmal-Routine in 4 Schritten</h2>

      {routine.map((s, i) => (
        <div class="step-block">
          <div class="step-header">
            <span class="step-nr">{i + 1}</span>
            <h3 class="step-title">{s.name}</h3>
          </div>
          <p class="step-text">{s.text}</p>
        </div>
      ))}

      <h2>Die richtigen Malbücher für lange Abende</h2>
      <p>
        Nicht jedes Motiv passt zu jeder Stimmung. Diese drei aus meiner Kollektion eignen sich besonders gut für ruhige Herbstabende:
      </p>

      <div class="buch-grid">
        {buecher.map(b => (
          <a href={`${base}/malen#malbuecher`} class="buch-card">
            <img src={b.image} alt={b.title} loading="lazy" />
            <div class="buch-card-content">
              <h3>{b.title}</h3>
              <p>{b.beschreibung}</p>
              <span class="buch-preis">{b.preis}</span>
            </div>
          </a>
        ))}
      </div>

      <div class="fazit-box">
        <p><strong>Fazit:</strong> Man braucht nicht viel für einen perfekten Herbstabend — ein Malbuch, eine Kerze, eine Tasse Tee. Der Rest ist einfach nur: ankommen und Farbe für Farbe entspannen.</p>
      </div>

      <div class="article-cta">
        <p>Finde dein Malbuch für die nächsten Herbstabende:</p>
        <a href={`${base}/malen#malbuecher`} class="btn btn-accent">Malbücher entdecken</a>
      </div>

    </div>
  </article>

  <section class="section back-section bg-light">
    <div class="container text-center">
      <a href={`${base}/blog`} class="btn btn-secondary">Weitere Blog-Artikel</a>
    </div>
  </section>
</Layout>

<style>
  .article-hero { padding: 4rem 0 2.5rem; background: var(--color-bg-white); border-bottom: 1px solid var(--color-border); }
  .article-meta { display: flex; align-items: center; gap: 1.5rem; margin-bottom: 1.5rem; flex-wrap: wrap; }
  .back-link { display: flex; align-items: center; gap: 6px; font-family: var(--font-title); font-size: 0.88rem; font-weight: 600; color: var(--color-text-muted); transition: color var(--transition-fast); }
  .back-link:hover { color: var(--color-teal); }
  .article-category { font-family: var(--font-title); font-size: 0.78rem; font-weight: 700; color: #b45309; text-transform: uppercase; letter-spacing: 0.08em; background: rgba(217,119,6,0.12); padding: 3px 10px; border-radius: 20px; }
  .article-title { font-size: clamp(1.8rem, 3.5vw, 2.8rem); line-height: 1.2; color: var(--color-navy); max-width: 820px; margin-bottom: 0.75rem; }
  .article-date { font-family: var(--font-title); font-size: 0.88rem; color: var(--color-text-muted); }
  .article-body { padding: 3.5rem 0 4rem; }
  .article-container { max-width: 740px; margin: 0 auto; }
  .article-container p { font-size: 1.05rem; line-height: 1.85; color: var(--color-text); margin-bottom: 1.5rem; }
  .article-container h2 { font-size: 1.5rem; color: var(--color-navy); margin: 2.5rem 0 1.25rem; }
  .article-figure { margin: 2rem 0 2.5rem; }
  .article-figure--top img { width: 100%; height: auto; border-radius: 12px; box-shadow: var(--shadow-md); display: block; }
  .article-cta { background: var(--color-bg-light); border-left: 4px solid var(--color-teal); border-radius: 0 12px 12px 0; padding: 1.5rem 2rem; margin-top: 2.5rem; display: flex; align-items: center; gap: 1.5rem; flex-wrap: wrap; }
  .article-cta p { margin: 0 !important; font-weight: 500; flex: 1; min-width: 200px; }
  .back-section { padding: 3rem 0; }
  .step-block { margin-bottom: 2rem; padding-bottom: 2rem; border-bottom: 1px solid var(--color-border); }
  .step-block:last-of-type { border-bottom: none; }
  .step-header { display: flex; align-items: center; gap: 1rem; margin-bottom: 0.75rem; }
  .step-nr { width: 2rem; height: 2rem; border-radius: 50%; background: #d97706; color: white; font-family: var(--font-title); font-weight: 700; font-size: 0.9rem; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
  .step-title { font-size: 1.15rem; color: var(--color-navy); margin: 0; font-family: var(--font-title); font-weight: 700; }
  .step-text { color: var(--color-text-muted); margin-bottom: 0 !important; }
  .fazit-box { background: rgba(217,119,6,0.08); border-radius: 12px; padding: 1.25rem 1.5rem; margin: 2rem 0; font-size: 1.05rem; line-height: 1.75; }

  .buch-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.25rem; margin: 1.5rem 0 2.5rem; }
  .buch-card { background: var(--color-bg-light); border-radius: 12px; overflow: hidden; box-shadow: var(--shadow-sm); display: flex; flex-direction: column; text-decoration: none; color: inherit; transition: transform var(--transition-fast), box-shadow var(--transition-fast); }
  .buch-card:hover { transform: translateY(-3px); box-shadow: var(--shadow-md); }
  .buch-card img { width: 100%; aspect-ratio: 4 / 3; object-fit: cover; display: block; }
  .buch-card-content { padding: 1rem 1.1rem 1.2rem; display: flex; flex-direction: column; gap: 0.4rem; flex: 1; }
  .buch-card-content h3 { font-size: 1rem; color: var(--color-navy); margin: 0; }
  .buch-card-content p { font-size: 0.88rem; line-height: 1.55; color: var(--color-text-muted); margin: 0; flex: 1; }
  .buch-preis { font-family: var(--font-title); font-weight: 700; font-size: 0.9rem; color: #b45309; margin-top: 0.3rem; }

  @media (max-width: 720px) {
    .buch-grid { grid-template-columns: 1fr; }
  }
</style>
