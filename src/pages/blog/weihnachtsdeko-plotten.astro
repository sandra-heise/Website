---
import Layout from '../../layouts/Layout.astro';
import { FREE_DOWNLOADS } from '../../config/downloads';
import { outUrl } from '../../utils/outboundLink';
import { dlUrl } from '../../utils/downloadLink';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const SITE = "https://sunnyartis.de";
const canonicalUrl = `${SITE}/blog/weihnachtsdeko-plotten/`;
const heroBild = "/blog/hirsch-lampe1.jpg";
const ogImage = `${SITE}${heroBild}`;
// Hochformat 1000x1500 für Pinterest (beim Pinnen dieses Bild wählen)
const pinImage = `${SITE}/blog/weihnachtsdeko-pin.jpg`;

const MEGA_BUNDLE_URL = "https://sunnyartis.etsy.com/listing/4589624412";
const BASTEL_BUNDLE_URL = "https://sunnyartis.etsy.com/listing/4589633263";

const wichtel = FREE_DOWNLOADS.find((d) => d.id === "0107wichtel")!;
const anhaenger = FREE_DOWNLOADS.find((d) => d.id === "0071Weihnachtsanhaenger")!;

// Drei Projekte, jeweils kurze Anleitung. bilder: Pfade relativ zu public/, leer = keine Bildreihe
const projekte = [
  {
    id: "windlicht",
    titel: "Windlicht mit Hirsch",
    intro: "Ein Windlicht aus dunklem Karton mit Hirsch, Fuchs und Sternen: Durch die ausgeschnittenen Motive fällt das Licht nach außen, die helle Innenseite sorgt für ein warmes, weiches Leuchten. Ich habe zwei Größen gebastelt — zusammen sehen sie besonders schön aus.",
    schritte: [
      "Vorlage im Schneideprogramm öffnen und auf die gewünschte Größe ziehen.",
      "Die Seitenteile aus dunklem, dickem Karton (mind. 160 g/m²) plotten.",
      "Die Rückseite mit Transparentpapier bekleben, damit das Licht gleichmäßig durchscheint.",
      "Kanten mit einem Lineal falzen und die Seitenteile an den Laschen zusammenkleben.",
      "Ein LED-Teelicht hineinstellen — keine echte Flamme.",
    ],
    bilder: ["/blog/hirsch-lampe2.jpg"],
    alt: ["Großes schwarzes Windlicht mit Fuchs und Sternen neben kleinem braunem Windlicht mit Hirsch"],
  },
  {
    id: "anhaenger",
    titel: "Geschenkanhänger",
    intro: "Selbst geplottete Anhänger machen aus jedem Päckchen ein persönliches Geschenk. Im kostenlosen Set stecken Schneeflocken, ein Tannenbaum, eine Christbaumkugel und verschiedene Etiketten mit „Frohe Weihnachten“ — in Gold-Glitzer und Kraftpapier wirken sie besonders edel.",
    schritte: [
      "Die Datei herunterladen und mehrere Anhänger nebeneinander auf einem Bogen anordnen — das spart Papier.",
      "Aus Glitzerkarton, Goldkarton oder Kraftpapier plotten.",
      "Schriftzüge ausschneiden oder mit einem Plotterstift aufzeichnen lassen.",
      "Bäckergarn oder eine Kordel durch das Loch fädeln und ans Geschenk knoten.",
    ],
    bilder: ["/blog/geschenkanhaenger-1.jpg", "/blog/geschenkanhaenger-2.jpg", "/blog/geschenkanhaenger-3.jpg"],
    alt: [
      "Geplottete Geschenkanhänger in Gold mit Schneeflocke, Tannenbaum und Christbaumkugel an verpackten Geschenken",
      "Zwei Geschenke mit goldenen Schneeflocken- und Christbaumkugel-Anhängern an Bäckergarn",
      "Verschiedene Geschenkanhänger aus Gold-Glitzer und Kraftpapier mit Schriftzug Frohe Weihnachten",
    ],
    hochformat: true,
  },
  {
    id: "wichtel",
    titel: "Weihnachtswichtel",
    intro: "Drei Wichtel ziehen mit ihrem Geschenksack zum Tannenbaum — als Fensterbild, auf einer Weihnachtskarte oder als Aufdruck auf Kissen und Tassen.",
    schritte: [
      "Material wählen: Vinyl für Glas und Tassen, Flexfolie für Stoff, Karton für Karten.",
      "Motiv plotten (bei Folie gespiegelt für Flex, normal für Vinyl).",
      "Überschüssige Folie bzw. Papierreste entgittern.",
      "Bei Vinyl mit Transferfolie aufbringen, bei Flexfolie aufbügeln oder mit der Presse übertragen.",
    ],
    bilder: ["/blog/wichtel-fensterbild.jpg", "/blog/wichtel-karte.jpg"],
    alt: [
      "Weihnachtswichtel als weißes Fensterbild mit Tannenbaum und Merry Christmas (Mock-up)",
      "Weihnachtswichtel auf roter Weihnachtskarte (Mock-up)",
    ],
  },
];

const faq = [
  {
    frage: "Brauche ich einen Plotter für die Weihnachtsdeko?",
    antwort: "Für das Windlicht und die Geschenkanhänger nicht zwingend — die Vorlagen lassen sich ausdrucken und mit Schere und Cutter ausschneiden. Mit einem Plotter geht es aber deutlich schneller und genauer. Für Vinyl- und Flexfolie (Wichtel auf Glas oder Stoff) ist ein Plotter nötig.",
  },
  {
    frage: "Sind die Plotterdateien kostenlos?",
    antwort: "Der Weihnachtswichtel und die Geschenkanhänger sind kostenlos und ohne Anmeldung herunterladbar, für den privaten Gebrauch. Das Windlicht mit Hirsch ist Teil des Bastelvorlagen Bundles auf Etsy.",
  },
  {
    frage: "Kann ich echte Kerzen in das Windlicht stellen?",
    antwort: "Nein. Papier ist brennbar — verwende ausschließlich LED-Teelichter oder Lichterketten mit Batterie.",
  },
];
---

<Layout
  title="Weihnachtsdeko plotten – Windlicht, Geschenkanhänger & Wichtel | Sunny Artis"
  description="Weihnachtsdeko selber plotten: Windlicht mit Hirsch, Geschenkanhänger und Weihnachtswichtel mit kurzer Anleitung. Anhänger und Wichtel als kostenlose Plotterdatei."
  ogImage={ogImage}
  canonical={canonicalUrl}
>
  <meta name="keywords" content="Weihnachtsdeko plotten, Plotterdatei Weihnachten, Windlicht basteln, Geschenkanhänger plotten, Wichtel Plotterdatei kostenlos, Weihnachten basteln, Malbuch Weihnachtsgeschenk" slot="head" />
  <meta property="article:published_time" content="2026-11-02" slot="head" />
  <meta property="article:author" content="Sandra Heise" slot="head" />
  <meta property="article:section" content="Basteln & Plotten" slot="head" />
  <meta property="article:tag" content="Weihnachten" slot="head" />
  <meta property="article:tag" content="Plotter" slot="head" />
  <meta property="article:tag" content="Basteln" slot="head" />
  <meta property="og:type" content="article" slot="head" />
  <script is:inline type="application/ld+json" slot="head" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    "headline": "Weihnachtsdeko plotten – Windlicht, Geschenkanhänger & Wichtel",
    "description": "Weihnachtsdeko selber plotten: Windlicht mit Hirsch, Geschenkanhänger und Weihnachtswichtel mit kurzer Anleitung.",
    "image": ogImage,
    "datePublished": "2026-11-02",
    "dateModified": "2026-11-02",
    "keywords": "Weihnachtsdeko, Plotterdatei, Windlicht, Geschenkanhänger, Wichtel, Weihnachten basteln",
    "inLanguage": "de",
    "url": canonicalUrl,
    "mainEntityOfPage": { "@type": "WebPage", "@id": canonicalUrl },
    "author": { "@type": "Person", "name": "Sandra Heise", "url": SITE, "sameAs": ["https://www.instagram.com/sunny_artis/"] },
    "publisher": { "@type": "Person", "name": "Sandra Heise", "url": SITE },
    "isPartOf": { "@type": "Blog", "name": "Sunny Artis Blog", "url": `${SITE}/blog/` }
  })} />
  <script is:inline type="application/ld+json" slot="head" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": faq.map((f) => ({
      "@type": "Question",
      "name": f.frage,
      "acceptedAnswer": { "@type": "Answer", "text": f.antwort }
    }))
  })} />
  <script is:inline type="application/ld+json" slot="head" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Startseite", "item": `${SITE}/` },
      { "@type": "ListItem", "position": 2, "name": "Blog", "item": `${SITE}/blog/` },
      { "@type": "ListItem", "position": 3, "name": "Weihnachtsdeko plotten", "item": canonicalUrl }
    ]
  })} />

  <section class="article-hero">
    <div class="container">
      <div class="article-meta">
        <a href={`${base}/blog/`} class="back-link">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="19" y1="12" x2="5" y2="12"></line><polyline points="12 19 5 12 12 5"></polyline></svg>
          Zurück zum Blog
        </a>
        <span class="article-category">Basteln & Plotten</span>
      </div>
      <h1 class="article-title">Weihnachtsdeko plotten – Windlicht, Geschenkanhänger & Wichtel</h1>
      <p class="article-date">2. November 2026 · von Sandra Heise</p>
    </div>
  </section>

  <article class="article-body">
    <div class="container article-container">

      <figure class="article-figure article-figure--top">
        <img src={`${base}${heroBild}`} alt="Zwei geplottete Windlichter aus dunklem Karton mit leuchtendem Hirsch, Fuchs und Sternen" data-pin-media={pinImage} fetchpriority="high" loading="eager" />
      </figure>

      <p>
        Spätestens zum 1. Advent darf es bei uns weihnachtlich werden. Drei Projekte habe ich in den letzten Wochen geplottet: ein Windlicht mit Hirsch, Geschenkanhänger und unsere Weihnachtswichtel. Alle drei sind an einem Nachmittag fertig — und zwei der Dateien gibt es kostenlos.
      </p>

      <nav class="inhalt-box" aria-label="Inhalt">
        <strong>Inhalt</strong>
        <ul>
          {projekte.map((p) => <li><a href={`#${p.id}`}>{p.titel}</a></li>)}
          <li><a href="#malbuch">Malbuch als Weihnachtsgeschenk</a></li>
        </ul>
      </nav>

      <div class="material-box">
        <h3>Das brauchst du</h3>
        <div class="material-grid">
          <div>
            <strong>Material</strong>
            <ul>
              <li>Dickes Papier / Karton (mind. 160 g/m²)</li>
              <li>Transparentpapier</li>
              <li>Vinyl- oder Flexfolie</li>
              <li>Band oder Kordel</li>
              <li>LED-Teelicht</li>
            </ul>
          </div>
          <div>
            <strong>Werkzeug</strong>
            <ul>
              <li>Plotter (oder Schere &amp; Cutter)</li>
              <li>Lineal, Kleber</li>
              <li>Entgitterhaken</li>
            </ul>
          </div>
          <div>
            <strong>Dateien</strong>
            <ul>
              <li><a href={wichtel.url} download data-dl={dlUrl(wichtel)}>Wichtel (kostenlos)</a></li>
              <li><a href={anhaenger.url} download data-dl={dlUrl(anhaenger)}>Geschenkanhänger (kostenlos)</a></li>
              <li><a href={outUrl(BASTEL_BUNDLE_URL)} target="_blank" rel="noopener noreferrer">Windlicht: Bastelvorlagen Bundle (Etsy)</a></li>
            </ul>
          </div>
        </div>
      </div>

      {projekte.map((p, i) => (
        <section class="projekt" id={p.id}>
          <h2><span class="step-nr">{i + 1}</span> {p.titel}</h2>
          <p>{p.intro}</p>
          <ol class="schritt-liste">
            {p.schritte.map((s) => <li>{s}</li>)}
          </ol>
          {p.bilder.length > 0 && (
            <div class={`step-bilder step-bilder--${p.bilder.length}${p.hochformat ? " step-bilder--hoch" : ""}`}>
              {p.bilder.map((b, j) => (
                <img src={`${base}${b}`} alt={p.alt[j]} loading="lazy" />
              ))}
            </div>
          )}
          {p.id === "windlicht" && (
            <div class="article-cta">
              <p>Die Vorlage für das Windlicht steckt im <strong>Bastelvorlagen Bundle</strong> — zusammen mit weiteren Laternen und Bastelideen.</p>
              <a href={outUrl(BASTEL_BUNDLE_URL)} target="_blank" rel="noopener noreferrer" class="btn btn-accent">Zum Bundle auf Etsy</a>
            </div>
          )}
          {p.id === "anhaenger" && (
            <div class="article-cta">
              <p>Geschenkanhänger als SVG, DXF, PNG und JPG — kostenlos, ohne Anmeldung.</p>
              <a href={anhaenger.url} download data-dl={dlUrl(anhaenger)} class="btn btn-accent">Kostenlos herunterladen</a>
            </div>
          )}
          {p.id === "wichtel" && (
            <div class="article-cta">
              <p>Den Wichtel gibt es gratis. Mehr Weihnachtsmotive findest du im <strong>Weihnachts Mega Bundle</strong>.</p>
              <a href={wichtel.url} download data-dl={dlUrl(wichtel)} class="btn btn-accent">Wichtel kostenlos laden</a>
              <a href={outUrl(MEGA_BUNDLE_URL)} target="_blank" rel="noopener noreferrer" class="mehr-link">Weihnachts Mega Bundle (Etsy) →</a>
            </div>
          )}
        </section>
      ))}

      <h2 id="malbuch">Malbuch als Weihnachtsgeschenk</h2>
      <p>
        Wer noch ein Geschenk sucht, das nicht nach einem Abend im Schrank verschwindet: Ein Malbuch beschäftigt über die ganzen Feiertage — für Teenager, die gerne zeichnen, genauso wie für Erwachsene, die zwischen den Jahren abschalten wollen. Zusammen mit ein paar guten Buntstiften und einem selbst geplotteten Geschenkanhänger ist das ein persönliches Geschenk ohne großen Aufwand.
      </p>
      <p>
        Alle meine Malbücher — von „Fantasie in Farbe“ bis „Tiere &amp; Fabelwesen“ — findest du auf der Seite <a href={`${base}/malen/#malbuecher`}>Malbücher &amp; Ausmalleinwände</a>.
      </p>

      <h2>Häufige Fragen</h2>
      {faq.map((f) => (
        <div class="faq-item">
          <h3>{f.frage}</h3>
          <p>{f.antwort}</p>
        </div>
      ))}

      <div class="fazit-box">
        <p>🎄 <strong>Viel Spaß beim Plotten!</strong> Weitere Gratis-Dateien findest du unter <a href={`${base}/downloads/`}>kostenlose Downloads</a>.</p>
      </div>

    </div>
  </article>

  <section class="section back-section bg-light">
    <div class="container text-center">
      <a href={`${base}/blog/`} class="btn btn-secondary">Weitere Blog-Artikel</a>
    </div>
  </section>
</Layout>

<style>
  .article-hero { padding: 4rem 0 2.5rem; background: var(--color-bg-white); border-bottom: 1px solid var(--color-border); }
  .article-meta { display: flex; align-items: center; gap: 1.5rem; margin-bottom: 1.5rem; flex-wrap: wrap; }
  .back-link { display: flex; align-items: center; gap: 6px; font-family: var(--font-title); font-size: 0.88rem; font-weight: 600; color: var(--color-text-muted); transition: color var(--transition-fast); }
  .back-link:hover { color: var(--color-teal); }
  .article-category { font-family: var(--font-title); font-size: 0.78rem; font-weight: 700; color: var(--color-teal); text-transform: uppercase; letter-spacing: 0.08em; background: rgba(1,170,193,0.1); padding: 3px 10px; border-radius: 20px; }
  .article-title { font-size: clamp(1.8rem, 3.5vw, 2.8rem); line-height: 1.2; color: var(--color-navy); max-width: 820px; margin-bottom: 0.75rem; }
  .article-date { font-family: var(--font-title); font-size: 0.88rem; color: var(--color-text-muted); }
  .article-body { padding: 3.5rem 0 4rem; }
  .article-container { max-width: 740px; margin: 0 auto; }
  .article-container p { font-size: 1.05rem; line-height: 1.85; color: var(--color-text); margin-bottom: 1.5rem; }
  .article-container h2 { font-size: 1.5rem; color: var(--color-navy); margin: 2.5rem 0 1.25rem; scroll-margin-top: 6rem; }
  .article-container a:not(.btn) { color: var(--color-teal); text-decoration: underline; text-underline-offset: 3px; }
  .article-container a:not(.btn):hover { color: var(--color-navy); }
  .article-figure { margin: 2rem 0 2.5rem; text-align: center; }
  .article-figure--top img { width: 100%; height: auto; border-radius: 12px; box-shadow: var(--shadow-md); display: block; }
  .article-cta { background: var(--color-bg-light); border-left: 4px solid var(--color-teal); border-radius: 0 12px 12px 0; padding: 1.5rem 2rem; margin-top: 1.5rem; display: flex; align-items: center; gap: 1.5rem; flex-wrap: wrap; }
  .article-cta p { margin: 0 !important; font-weight: 500; flex: 1; min-width: 200px; }
  .mehr-link { font-family: var(--font-title); font-size: 0.85rem; font-weight: 600; color: var(--color-teal); transition: color var(--transition-fast); }
  .mehr-link:hover { color: var(--color-navy); }
  .back-section { padding: 3rem 0; }

  .inhalt-box { border: 1px solid var(--color-border); border-radius: 12px; padding: 1.25rem 1.5rem; margin: 0 0 2rem; }
  .inhalt-box strong { font-family: var(--font-title); color: var(--color-navy); }
  .inhalt-box ul { margin: 0.5rem 0 0; padding-left: 1.25rem; }

  .material-box { background: var(--color-bg-light); border-radius: 12px; padding: 1.5rem 2rem; margin: 2rem 0 2.5rem; }
  .material-box h3 { color: var(--color-navy); font-size: 1.05rem; margin: 0 0 1rem; }
  .material-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.5rem; }
  .material-grid strong { display: block; font-family: var(--font-title); font-size: 0.85rem; color: var(--color-navy); margin-bottom: 0.5rem; text-transform: uppercase; letter-spacing: 0.05em; }
  .material-grid ul { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 0.3rem; }
  .material-grid li { font-size: 0.9rem; color: var(--color-text-muted); }
  @media (max-width: 600px) { .material-grid { grid-template-columns: 1fr; } }

  .projekt { margin-bottom: 2.5rem; padding-bottom: 2.5rem; border-bottom: 1px solid var(--color-border); }
  .projekt h2 { display: flex; align-items: center; gap: 0.75rem; }
  .step-nr { width: 2rem; height: 2rem; border-radius: 50%; background: var(--color-teal); color: white; font-family: var(--font-title); font-weight: 700; font-size: 0.9rem; display: inline-flex; align-items: center; justify-content: center; flex-shrink: 0; }
  .schritt-liste { padding-left: 1.25rem; margin: 0 0 1.5rem; color: var(--color-text-muted); line-height: 1.8; }
  .step-bilder { display: grid; gap: 6px; border-radius: 10px; overflow: hidden; }
  .step-bilder--1 { grid-template-columns: 1fr; }
  .step-bilder--2 { grid-template-columns: 1fr 1fr; }
  .step-bilder--3 { grid-template-columns: 1fr 1fr 1fr; }
  .step-bilder img { width: 100%; aspect-ratio: 4/3; object-fit: cover; display: block; }
  .step-bilder--hoch img { aspect-ratio: 3/4; }

  .faq-item h3 { font-size: 1.05rem; color: var(--color-navy); margin: 1.5rem 0 0.5rem; }
  .fazit-box { background: rgba(1,170,193,0.08); border-radius: 12px; padding: 1.25rem 1.5rem; margin: 2rem 0; font-size: 1.05rem; }
  .fazit-box p { margin: 0 !important; }
</style>
